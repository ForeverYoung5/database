{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portal.public-search-input.v3.schema.json",
  "title": "TianGong Portal public search input v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "query",
    "filters",
    "sort",
    "cursor",
    "limit"
  ],
  "properties": {
    "kind": {
      "enum": [
        "process",
        "flow"
      ]
    },
    "query": {
      "type": "string",
      "maxLength": 512,
      "description": "At most 2048 UTF-8 bytes; C0/C1 control characters are rejected."
    },
    "filters": {
      "$ref": "#/$defs/NavigationSearchFiltersV3"
    },
    "sort": {
      "enum": [
        "relevance",
        "modified_desc",
        "name_asc"
      ]
    },
    "cursor": {
      "$ref": "./portal.common-types.v1.schema.json#/$defs/NullableCursor"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    }
  },
  "$defs": {
    "NavigationSearchFiltersV3": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 11,
      "properties": {
        "accessLevel": {
          "enum": [
            "open",
            "metadata_only"
          ]
        },
        "geography": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "classification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "referenceYearFrom": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "referenceYearTo": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "processSubtype": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "classificationNodeId": {
          "$ref": "./portal.public-navigation.v1.schema.json#/$defs/NavigationNodeId"
        },
        "geographyNodeId": {
          "$ref": "./portal.public-navigation.v1.schema.json#/$defs/NavigationNodeId"
        },
        "classificationScope": {
          "enum": [
            "subtree",
            "direct"
          ]
        },
        "geographyScope": {
          "enum": [
            "subtree",
            "direct"
          ]
        }
      },
      "dependentRequired": {
        "classificationScope": [
          "classificationNodeId"
        ],
        "geographyScope": [
          "geographyNodeId"
        ]
      },
      "description": "At most 4096 UTF-8 bytes. Year bounds must be ordered. Node ids must exist in their declared dimension. A missing scope means subtree; values and visibility remain server-validated."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "flow"
          }
        }
      },
      "then": {
        "properties": {
          "filters": {
            "type": "object",
            "properties": {
              "processSubtype": false
            }
          }
        }
      }
    }
  ]
}
